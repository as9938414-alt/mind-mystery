# Nothing here is required. Every game works with no keys at all.

# Leaderboard database. On Vercel, Neon Postgres (free) is connected and sets DATABASE_URL
# automatically. Upstash Redis (UPSTASH_REDIS_REST_URL/TOKEN) is also supported. With neither,
# scores are kept in data/mindmystery-db.json (fine on the local booth laptop).
DATABASE_URL=""

# AI rescue (optional, off by default). With a Gemini key, when the Oracle's guesses are
# wrong, Gemini takes over using the full Q&A and can find answers outside the database.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# Optional: official movie / series posters on the reveal.
TMDB_API_KEY=""

# Encrypts game state between requests. Required on Vercel (already set in the project).
SESSION_SECRET=""
