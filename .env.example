# Everything works WITHOUT any keys: Number Reader, Letters, Crystal Ball, the offline Oracle
# (~1,000 movies, actors, songs, singers, sports stars, foods, places, animals...) and Brain Arena.

# GEMINI_API_KEY (optional): when set, a "No, try again" on the Oracle hands the round to Gemini,
# which can find answers outside the built-in database, and Brain Arena gets fresh AI riddles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# TMDB_API_KEY (optional): shows the official movie / series poster on the reveal.
TMDB_API_KEY=""

APP_URL="MY_APP_URL"
